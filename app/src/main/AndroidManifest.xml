<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Os avisos na barra do celular; do Android 13 em diante, a pessoa precisa permitir -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- O despertador dos horários das notificações se perde quando o celular desliga -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- O despertador na hora certa. Vem liberada até o Android 13; do 14 em diante, vem desligada
         (Alarmes e lembretes, nas configurações do app), e o despertador pode atrasar -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Os relatórios de falhas do Crashlytics e os números de uso do Analytics saem pela internet. As
         bibliotecas do Google já trazem esta permissão; declarada aqui, ela fica à vista -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- O Analytics traz estas permissões, mas o app não tem anúncios: fica sem o ID de publicidade e
         sem as medições de anúncios do Android -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:name=".BoletimApp"
        android:allowBackup="true"
        android:backupAgent=".data.backup.BoletimBackupAgent"
        android:fullBackupOnly="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Boletim">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Boletim.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- O despertador do horário das notificações -->
        <receiver
            android:name=".avisos.AvisosReceiver"
            android:exported="false" />

        <!-- Marca o despertador de novo quando ele se perde ou fica na hora errada. Os avisos do
             sistema chegam mesmo sem exported -->
        <receiver
            android:name=".avisos.ReagendarAvisosReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- A pessoa liberou os alarmes e lembretes: o despertador pode ser exato -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Os relatórios de falhas: o build type decide, e no debug ficam desligados -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsLigado}" />

        <!-- Os números de uso: o build type decide, e no debug a coleta fica desligada -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="${analyticsDesligado}" />
        <!-- Sem anúncios: nada de ID de publicidade nem de dados para personalizar anúncios -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <!-- O app tem uma Activity só, e a contagem automática chamaria tudo de MainActivity: quem conta
             as telas é a moldura do app (ContarTela) -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
    </application>

</manifest>